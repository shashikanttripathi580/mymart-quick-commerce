# ==========================================
# MYMART - ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION (Free Tier)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------
# Customer App & Admin Dashboard Public URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (Safe for client browsers & mobile app)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (ONLY for Cloudflare Worker & Backend Scripts - NEVER expose in client apps!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Project JWT Secret (Used to verify tokens inside Cloudflare Worker)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings

# ------------------------------------------
# CLOUDFLARE R2 & WORKER CONFIGURATION
# ------------------------------------------
# Cloudflare Worker URL for Secure Image Uploads
VITE_IMAGE_WORKER_URL=https://mymart-image-worker.your-subdomain.workers.dev

# Cloudflare Account ID & R2 Bucket Name
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=mymart-product-images
R2_ACCESS_KEY_ID=your-r2-s3-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-s3-secret-access-key

# Public custom domain or r2.dev public URL for serving images
R2_PUBLIC_DOMAIN=https://images.mymartdelivery.in
